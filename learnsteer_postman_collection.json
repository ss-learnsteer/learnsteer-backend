      "name": "1. Authentication & Student Identity",
      "description": "Frictionless 3-click onboarding, multi-identifier login, and profile enrichment endpoints",
      "item": [
        {
          "name": "Create Student (3-Click Frictionless Onboarding)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var res = pm.response.json();",
                  "    if (res.data) {",
                  "        if (res.data.student_id) {",
                  "            pm.collectionVariables.set('student_id', res.data.student_id);",
                  "            console.log('Saved student_id: ' + res.data.student_id);",
                  "        }",
                  "        if (res.data.nickname) {",
                  "            pm.collectionVariables.set('nickname', res.data.nickname);",
                  "            console.log('Saved nickname: ' + res.data.nickname);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Kasun\",\n  \"last_name\": \"Perera\",\n  \"email\": \"kasun.student@example.com\",\n  \"password\": \"Password123\",\n  \"nic\": \"200612345678\",\n  \"whatsapp_number\": \"0771234567\",\n  \"stream\": \"Bio Science\",\n  \"medium\": \"Sinhala\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/create-student",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "create-student"]
            },
            "description": "Registers a lazy A/L student collecting only the 8 absolute essentials. Auto-generates a unique Student ID (e.g. LS-a1b2c3d4) and cartoon mascot nickname (e.g. BraveLion42)."
          }
        },
        {
          "name": "Login - via Nickname",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var res = pm.response.json();",
                  "    if (res.token) {",
                  "        pm.collectionVariables.set('jwt_token', res.token);",
                  "        console.log('Saved jwt_token');",
                  "    }",
                  "    if (res.user) {",
                  "        pm.collectionVariables.set('student_id', res.user.student_id);",
                  "        pm.collectionVariables.set('nickname', res.user.nickname);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
